# Exit Poll Venezuela — Variables de entorno
# Copiar a .env y completar los valores reales.
# En Azure: configurar en Portal > Configuration > Application Settings

# Puerto del servidor (Azure lo asigna automáticamente, no modificar en producción)
# PORT=8000

# Opcional: ruta absoluta a la BD si se quiere fuera del directorio backend/
# Por defecto: backend/exitpoll.db (relativo al script, resuelto con __file__)
# DB_PATH=/home/data/exitpoll.db
